# Microsoft Entra application registration
OUTLOOK_MCP_TENANT_ID=[MICROSOFT ENTRA TENANT ID]
OUTLOOK_MCP_CLIENT_ID=[APPLICATION CLIENT ID]
OUTLOOK_MCP_CLIENT_SECRET=[APPLICATION CLIENT SECRET]

# Shared mailbox that receives invoices
OUTLOOK_MCP_MAILBOX=[INVOICE MAILBOX ADDRESS]

# Outbound workflow notifications through Microsoft Graph Mail.Send.
# The sender must be within the Exchange Application RBAC scope granted to the
# app registration. Purchase Ledger receives PO matching and final-approval
# notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATION_SENDER=[INVOICE MAILBOX ADDRESS]
PURCHASE_LEDGER_NOTIFICATION_EMAIL=[PURCHASE LEDGER EMAIL ADDRESS]

# Direct Microsoft Graph settings used by the worker and subscription CLI
OUTLOOK_MCP_DOWNLOAD_DIR=outlook_downloads
OUTLOOK_MCP_MAX_PDF_BYTES=20971520
# Separate source-workbook upload limit; converted PDFs still use the PDF limit.
OUTLOOK_MCP_MAX_EXCEL_BYTES=52428800
# Existing SharePoint/OneDrive document-library drive used temporarily for
# Graph XLS/XLSX-to-PDF conversion. Falls back to SHAREPOINT_DRIVE_ID.
EXCEL_CONVERSION_DRIVE_ID=[SHAREPOINT DRIVE ID]
EXCEL_CONVERSION_TEMP_FOLDER=Invoice Conversion

# Microsoft Graph new-email webhook
# Must be a publicly reachable HTTPS URL in production.
OUTLOOK_WEBHOOK_URL=[PUBLIC HTTPS URL]/api/outlook/notifications
OUTLOOK_LIFECYCLE_URL=[PUBLIC HTTPS URL]/api/outlook/lifecycle
OUTLOOK_WEBHOOK_CLIENT_STATE=[RANDOM SECRET UP TO 128 CHARACTERS]
OUTLOOK_WEBHOOK_DB_PATH=runtime_data/outlook_notifications.db
OUTLOOK_SUBSCRIPTION_ID=[GRAPH SUBSCRIPTION ID AFTER CREATION]

# Worker connecting queued webhook events directly to Microsoft Graph
OUTLOOK_WORKER_POLL_SECONDS=2
OUTLOOK_LOCAL_POLLING_ENABLED=false
OUTLOOK_LOCAL_POLLING_LIMIT=20
INVOICE_DB_PATH=runtime_data/invoices.db

# SharePoint document library for invoice file management
# Site ID from: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
SHAREPOINT_SITE_ID=[SHAREPOINT SITE ID]
# Drive (document library) ID from: GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=[SHAREPOINT DRIVE ID]
# Folder path relative to the drive root for newly received invoices
SHAREPOINT_INCOMING_FOLDER=Invoices/Incoming Invoices
# The invoice worker polls this folder for PDFs that are not yet registered.
SHAREPOINT_INCOMING_POLL_SECONDS=2
# Local processing cache only; SharePoint remains the canonical PDF location.
SHAREPOINT_INVOICE_CACHE_DIR=runtime_data/sharepoint_invoice_cache

# Invoice metadata store backend: "sqlite" (default, local file, zero config)
# or "postgres" (Azure PostgreSQL using an Entra token as the password).
INVOICE_STORE_BACKEND=sqlite
# Optional override. When omitted, admin business configuration uses the same
# backend as INVOICE_STORE_BACKEND.
# CONFIG_STORE_BACKEND=sqlite
# Required only when INVOICE_STORE_BACKEND=postgres. The Invoice MCP Entra
# credentials above are reused when AZURE_POSTGRES_PASSWORD is omitted.
AZURE_POSTGRES_HOST=[SERVER].postgres.database.azure.com
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DATABASE=invoice_processing
AZURE_POSTGRES_USER=[INVOICE MCP DATABASE PRINCIPAL]
AZURE_POSTGRES_SSLMODE=verify-full
# Optional CA bundle path; the installed certifi bundle is used when omitted.
AZURE_POSTGRES_SSLROOTCERT=
# Keep false for the read/write Invoice MCP runtime role. A DBA/deployment
# identity can run `python -m app.postgres_migrate` when applying migrations.
AZURE_POSTGRES_AUTO_MIGRATE=false
# Password-authenticated deployments reuse PostgreSQL connections. Tune these
# only when the hosting plan or database connection limit requires it.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_MAX_IDLE_SECONDS=300
# Optional alternative to the individual settings above:
# DATABASE_URL=postgresql://[USER]@[HOST]:5432/invoice_processing?sslmode=verify-full
# Local PostgreSQL may use a password and disable TLS only over loopback:
# DATABASE_URL=postgresql://invoice_processor:[LOCAL PASSWORD]@127.0.0.1:5432/invoice_processing?sslmode=disable

# Legacy SharePoint List metadata backend; PostgreSQL is the intended
# authoritative production metadata store.
# Required only when INVOICE_STORE_BACKEND=sharepoint_list.
# Site ID from: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
SHAREPOINT_INVOICES_SITE_ID=[SHAREPOINT SITE ID]
# The GUID of the "Invoices" SharePoint List (create this list with one column
# per InvoiceRecord field -- see app/sharepoint_invoice_store.py FIELD_COLUMNS)
SHAREPOINT_INVOICES_LIST_ID=[SHAREPOINT LIST ID]

# Azure AI Document Intelligence (prebuilt invoice model). Authentication uses
# the Invoice MCP Entra credentials above; assign its service principal the
# Cognitive Services User role on this resource. No resource API key is used.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=[AZURE DOCUMENT INTELLIGENCE ENDPOINT URL]
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-invoice
# Minimum per-field confidence (0.0-1.0) required before an extracted value is
# trusted rather than routed to Needs Review. Admins can also override this at
# runtime via the Admin panel (stored in the process_configuration table).
AI_CONFIDENCE_THRESHOLD=0.80

# Authentication
AUTH_DB_PATH=runtime_data/auth.db
# Microsoft Entra web application registration. Leave all four blank to use
# local development login. The callback URI must exactly match a Web redirect
# URI configured on the app registration.
AUTH_ENTRA_TENANT_ID=[MICROSOFT ENTRA TENANT ID]
AUTH_ENTRA_CLIENT_ID=[APPLICATION CLIENT ID]
AUTH_ENTRA_CLIENT_SECRET=[APPLICATION CLIENT SECRET]
AUTH_ENTRA_REDIRECT_URI=https://invoice.example.com/api/auth/microsoft/callback
AUTH_ENTRA_POST_LOGOUT_REDIRECT_URI=https://invoice.example.com/
# Local passwords are disabled by default when Entra is configured. Enable
# only for controlled development or emergency access.
AUTH_LOCAL_LOGIN_ENABLED=false
# Must be true for HTTPS production deployments. Set false only for local HTTP.
AUTH_COOKIE_SECURE=true

# Local path used when CONFIG_STORE_BACKEND=sqlite. It does not choose the
# backend; PostgreSQL invoice deployments use PostgreSQL configuration unless
# CONFIG_STORE_BACKEND=sqlite is set explicitly.
CONFIG_DB_PATH=runtime_data/config.db

# Sage 200 (or equivalent finance system) -- posting confirmed invoices /
# IRJs and pulling remittance/payment status. Not yet integrated; placeholder
# only, see app/invoice_lifecycle.py payment stage.
SAGE_API_URL=[SAGE API BASE URL]
SAGE_API_KEY=[SAGE API KEY]
