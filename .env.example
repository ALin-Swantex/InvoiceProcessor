# Microsoft Entra application registration (service principal). The same
# credentials also authenticate to Azure PostgreSQL and Document Intelligence.
# Legacy OUTLOOK_MCP_* names are still accepted but deprecated.
GRAPH_TENANT_ID=[MICROSOFT ENTRA TENANT ID]
GRAPH_CLIENT_ID=[APPLICATION CLIENT ID]
GRAPH_CLIENT_SECRET=[APPLICATION CLIENT SECRET]

# Shared mailbox that receives invoices
GRAPH_MAILBOX=[INVOICE MAILBOX ADDRESS]

# Outbound workflow notifications through Microsoft Graph Mail.Send.
# The sender must be within the Exchange Application RBAC scope granted to the
# app registration. Purchase Ledger receives PO matching and final-approval
# notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATION_SENDER=[INVOICE MAILBOX ADDRESS]
PURCHASE_LEDGER_NOTIFICATION_EMAIL=[PURCHASE LEDGER EMAIL ADDRESS]
# Public address used in approval and reminder email links.
APP_PUBLIC_URL=http://127.0.0.1:8000
APPROVAL_REMINDER_SCAN_SECONDS=300

# Direct Microsoft Graph settings used by the worker and subscription CLI
OUTLOOK_DOWNLOAD_DIR=outlook_downloads
OUTLOOK_MAX_PDF_BYTES=20971520
# Separate source-workbook upload limit; converted PDFs still use the PDF limit.
OUTLOOK_MAX_EXCEL_BYTES=52428800
# Existing SharePoint/OneDrive document-library drive used temporarily for
# Graph XLS/XLSX-to-PDF conversion. Falls back to SHAREPOINT_DRIVE_ID.
EXCEL_CONVERSION_DRIVE_ID=[SHAREPOINT DRIVE ID]
EXCEL_CONVERSION_TEMP_FOLDER=Invoice Conversion

# Microsoft Graph new-email webhook
# Must be a publicly reachable HTTPS URL in production.
OUTLOOK_WEBHOOK_URL=[PUBLIC HTTPS URL]/api/outlook/notifications
OUTLOOK_LIFECYCLE_URL=[PUBLIC HTTPS URL]/api/outlook/lifecycle
OUTLOOK_WEBHOOK_CLIENT_STATE=[RANDOM SECRET UP TO 128 CHARACTERS]
# The subscription id printed by `python3 -m app.outlook_subscription create`
# is passed to `renew` on the command line; nothing reads it from here.

# Worker connecting queued webhook events directly to Microsoft Graph
OUTLOOK_WORKER_POLL_SECONDS=2
OUTLOOK_LOCAL_POLLING_ENABLED=false
OUTLOOK_LOCAL_POLLING_LIMIT=20
# 0 means midnight today in Europe/London. Increase temporarily if the worker
# must recover unread invoices from earlier days after an outage.
OUTLOOK_LOCAL_POLLING_LOOKBACK_DAYS=0
# The first poll after the worker starts looks back this many days, so unread
# invoices that arrived while it was down are still picked up. Default 3.
# OUTLOOK_LOCAL_POLLING_CATCH_UP_DAYS=3
# Attachments of one email downloaded/converted/uploaded in parallel (default 3).
# Registration (duplicate checks, invoice rows, extraction) stays sequential.
# OUTLOOK_WORKER_CONCURRENCY=3
# Queue items left in 'processing' longer than this (e.g. after a crash) are
# returned to 'pending' (or 'failed' after 5 attempts). Default 900; 0 disables.
# OUTLOOK_PROCESSING_STALE_SECONDS=900
# Invoices still in 'Awaiting AI Extraction' this long after they arrived (the
# extraction failed, e.g. on a network drop) are extracted again; checked every
# 5 minutes. Default 900; 0 disables.
# STUCK_EXTRACTION_RETRY_SECONDS=900
# Worker log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO

# SharePoint document library for invoice file management
# Site ID from: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
SHAREPOINT_SITE_ID=[SHAREPOINT SITE ID]
# Drive (document library) ID from: GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=[SHAREPOINT DRIVE ID]
# Folder path relative to the drive root for newly received invoices
SHAREPOINT_INCOMING_FOLDER=Invoices/Incoming Invoices
# Shared review queue. Create this folder alongside Incoming Invoices.
SHAREPOINT_FLAGGED_FOLDER=Invoices/Flagged Invoices
# The invoice worker polls this folder for PDFs that are not yet registered.
# Independent of OUTLOOK_WORKER_POLL_SECONDS; falls back to it when unset.
SHAREPOINT_INCOMING_POLL_SECONDS=2
# Local processing cache only; SharePoint remains the canonical PDF location.
SHAREPOINT_INVOICE_CACHE_DIR=runtime_data/sharepoint_invoice_cache

# PostgreSQL is the authoritative store for invoices, configuration, sessions,
# activity, IRJ sequences, and the Outlook processing queue.
INVOICE_STORE_BACKEND=postgres
CONFIG_STORE_BACKEND=postgres
# SQLite files used only when a backend above is not postgres (development).
# CONFIG_DB_PATH=runtime_data/config.db
# INVOICE_DB_PATH=runtime_data/invoices.db
# Where manually uploaded PDFs are kept before filing (default manual_uploads).
# MANUAL_UPLOAD_DIR=manual_uploads
# The Invoice MCP Entra credentials above are reused when
# AZURE_POSTGRES_PASSWORD is omitted.
AZURE_POSTGRES_HOST=[SERVER].postgres.database.azure.com
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DATABASE=invoice_processing
AZURE_POSTGRES_USER=[INVOICE MCP DATABASE PRINCIPAL]
# AZURE_POSTGRES_PASSWORD=[DATABASE PASSWORD]
AZURE_POSTGRES_SSLMODE=verify-full
# Optional CA bundle path; the installed certifi bundle is used when omitted.
AZURE_POSTGRES_SSLROOTCERT=
# Keep false for the read/write Invoice MCP runtime role. A DBA/deployment
# identity can run `python -m app.postgres_migrate` when applying migrations.
# With false, the app and worker refuse to start while a migration is pending.
AZURE_POSTGRES_AUTO_MIGRATE=false
# Password-authenticated deployments reuse PostgreSQL connections. Tune these
# only when the hosting plan or database connection limit requires it.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=30
# Maximum time for an individual PostgreSQL TCP/TLS connection attempt.
POSTGRES_CONNECT_TIMEOUT_SECONDS=15
POSTGRES_POOL_MAX_IDLE_SECONDS=300
# Optional alternative to the individual settings above:
# DATABASE_URL=postgresql://[USER]@[HOST]:5432/invoice_processing?sslmode=verify-full
# Local PostgreSQL may use a password and disable TLS only over loopback:
# DATABASE_URL=postgresql://invoice_processor:[LOCAL PASSWORD]@127.0.0.1:5432/invoice_processing?sslmode=disable

# AI invoice extraction with Claude. Invoice PDFs (first and last page of long
# ones) are sent to the Anthropic API, so confirm your data-handling terms first.
# Use an API key, or run `ant auth login` and set EXTRACTION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=[ANTHROPIC API KEY]
# Alternative to the API key: a bearer token for the Anthropic API.
# ANTHROPIC_AUTH_TOKEN=[ANTHROPIC AUTH TOKEN]
# anthropic (default when a key is set) or none to turn extraction off.
# EXTRACTION_PROVIDER=anthropic   # set only to use an `ant auth login` profile, or none to disable
# The first-pass model reads every invoice. If it has difficulty (a missing or
# uncertain field, or a failed check), the escalation model reads it again and its
# answer is used; a confident disagreement between the two goes to Needs Review.
# Leave EXTRACTION_ESCALATION_MODEL blank to use one model for everything.
EXTRACTION_MODEL=claude-sonnet-5-5
EXTRACTION_ESCALATION_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max. Leave blank for models without effort support.
EXTRACTION_EFFORT=medium
EXTRACTION_ESCALATION_EFFORT=high
EXTRACTION_TIMEOUT_SECONDS=120
# The model and prompt version are recorded with every extraction automatically
# so corrections can be compared by model in PostgreSQL and Power BI.
# Labels recorded only when an extraction does not report its own model or
# prompt version (default "unspecified").
# INVOICE_EXTRACTION_MODEL=[MODEL LABEL]
# INVOICE_EXTRACTION_PROMPT_VERSION=[PROMPT VERSION LABEL]
# Minimum per-field confidence (0.0-1.0) required before an extracted value is
# trusted rather than routed to Needs Review. Admins can also override this at
# runtime via the Admin panel (stored in the process_configuration table).
AI_CONFIDENCE_THRESHOLD=0.80
# The health endpoint and Admin monitoring panel flag an Outlook worker whose
# latest PostgreSQL heartbeat is older than this many seconds.
WORKER_STALE_AFTER_SECONDS=120

# Authentication
# Microsoft Entra web application registration. Leave all four blank to use
# local development login. The callback URI must exactly match a Web redirect
# URI configured on the app registration.
AUTH_ENTRA_TENANT_ID=[MICROSOFT ENTRA TENANT ID]
AUTH_ENTRA_CLIENT_ID=[APPLICATION CLIENT ID]
AUTH_ENTRA_CLIENT_SECRET=[APPLICATION CLIENT SECRET]
AUTH_ENTRA_REDIRECT_URI=https://invoice.example.com/api/auth/microsoft/callback
AUTH_ENTRA_POST_LOGOUT_REDIRECT_URI=https://invoice.example.com/
# Local passwords are disabled by default when Entra is configured. Enable
# only for controlled development or emergency access.
AUTH_LOCAL_LOGIN_ENABLED=false
# Must be true for HTTPS production deployments. Set false only for local HTTP.
AUTH_COOKIE_SECURE=true

# Sage 200 (or equivalent finance system) -- posting confirmed invoices /
# IRJs and pulling remittance/payment status. Not yet integrated; placeholder
# only, see app/invoice_lifecycle.py payment stage.
SAGE_API_URL=[SAGE API BASE URL]
SAGE_API_KEY=[SAGE API KEY]
